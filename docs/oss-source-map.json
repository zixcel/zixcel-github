  "workflow_definitions": [
    {
      "path": ".github/workflows/cargo-package.yml",
      "jobs": [
        {
          "job": "cargo-package",
          "condition": null,
          "runs_on": "ubuntu-24.04",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
              "condition": null
            },
            {
              "name": "Isolate public registry configuration and build output",
              "run": "echo \"CARGO_HOME=$RUNNER_TEMP/public-cargo-home\" >> \"$GITHUB_ENV\"\necho \"CARGO_TARGET_DIR=$RUNNER_TEMP/public-cargo-target\" >> \"$GITHUB_ENV\"\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Install the declared Rust toolchain",
              "run": "rustup toolchain install 1.97 --profile minimal --component rustfmt --component clippy",
              "uses": null,
              "condition": null
            },
            {
              "name": "Check formatting and all-feature lints",
              "run": "cargo +1.97 fmt --all -- --check\ncargo +1.97 clippy --locked --all-targets --all-features -- -D warnings\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Exercise behavioral and documentation tests",
              "run": "cargo +1.97 test --locked --all-features",
              "uses": null,
              "condition": null
            },
            {
              "name": "Generate and build the independent public package",
              "run": "cargo +1.97 package --locked --registry crates-io",
              "uses": null,
              "condition": null
            },
            {
              "name": "Record exact source and package bytes",
              "run": "mkdir -p \"$GITHUB_WORKSPACE/outgoing\"\ncp \"$CARGO_TARGET_DIR/package/zixcel-github-egress-contracts-0.10.0.crate\" \"$GITHUB_WORKSPACE/outgoing/\"\nprintf '%s\\n' \"$EXPECTED_SHA\" > \"$GITHUB_WORKSPACE/outgoing/source-sha.txt\"\ncd \"$GITHUB_WORKSPACE/outgoing\"\nsha256sum zixcel-github-egress-contracts-0.10.0.crate > SHA256SUMS\n",
              "uses": null,
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
              "condition": null
            }
          ]
        }
      ]
    },
    {
