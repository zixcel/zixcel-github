{
  "repository": "zixcel/zixcel-github",
  "purpose": "Build and validate typed GitHub requests for repository observation and explicitly enabled operations.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-github",
      "ecosystem": "rust",
      "description": "Policy-neutral GitHub API wrapper boundary for Zixcel",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "action::{GitHubAction, GitHubRemoteExpectation, PermissionRequirement}",
          "artifacts::{\n    GitHubSnapshotArtifact, GitHubSnapshotFile, GitHubTextArtifact, GitHubWorkflowInputsArtifact,\n    parse_snapshot_artifact, parse_text_artifact, parse_workflow_inputs_artifact,\n}",
          "boundary::ConnectorError",
          "config::{ConnectorConfig, parse_config}",
          "execution::{\n    execute_api_request, execute_configured_request, parse_api_request_json, validate_api_request,\n}",
          "execution_model::{\n    GitHubApiReceipt, GitHubApiRequest, GitHubBackend, GitHubBackendReceipt,\n    RequestValidationReport,\n}",
          "plan::{ConnectorPlan, PlanStep, build_plan}",
          "reports::{\n    CapabilityReport, DoctorReport, ValidationReport, capabilities, doctor, validation_report,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/zixcel-github-egress-contracts/Cargo.toml",
      "package": "zixcel-github-egress-contracts",
      "ecosystem": "rust",
      "description": "Bounded GitHub egress contracts and authorization validation",
      "interfaces": {
        "lib": "crates/zixcel-github-egress-contracts/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "github::{\n    GitHubAuthorizationV1, GitHubEgressCommandV1, GitHubEgressMode, GitHubEgressReceiptV1,\n    GitHubVerificationReceiptV1, authorization_digest, github_connection_ref_digest,\n    github_document_digest, validate_github_command, validate_github_egress_receipt,\n    validate_github_verification_receipt,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/zixcel-github-transport/Cargo.toml",
      "package": "zixcel-github-transport",
      "ecosystem": "rust",
      "description": null,
      "interfaces": {
        "lib": "crates/zixcel-github-transport/src/lib.rs",
        "features": {},
        "bins": [
          {
            "name": "zixcel-github-transport",
            "path": "src/main.rs"
          }
        ],
        "public_modules": [],
        "public_reexports": [
          "config::{GitHubTransportConfigV1, GitHubTransportTrustV1}",
          "execute::{GitHubProvider, execute_command}",
          "github_provider::PlatformGitHubProvider",
          "ledger::{ExecutionLedger, ExecutionStart}",
          "model::TransportError"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "maintenance/pyproject.toml",
      "package": "zixcel-github-maintenance",
      "ecosystem": "python",
      "description": "Explicit-scope GitHub repository maintenance with existing gh authentication",
      "interfaces": {
        "bin": {
          "zix-github-maintenance": "zixcel_github_maintenance.__main__:main"
        }
      },
      "declared_commands": {
        "test": "PYTHONPATH=maintenance python3 -m unittest discover -s maintenance/tests -v"
      }
    }
  ],
